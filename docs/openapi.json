  "components": {
    "schemas": {
      "AssessmentInput": {
        "properties": {
          "domain": {
            "type": "string",
            "title": "Domain"
          },
          "answers": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Answers"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "domain",
          "answers"
        ],
        "title": "AssessmentInput"
      },
      "DoubtInput": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 150,
            "minLength": 3,
            "title": "Title"
          },
          "description": {
            "type": "string",
            "maxLength": 3000,
            "minLength": 5,
            "title": "Description"
          },
          "domain": {
            "type": "string",
            "title": "Domain"
          },
          "skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "title": "Skills"
          },
          "urgency": {
            "type": "string",
            "enum": [
              "Urgent",
              "Normal",
              "Flexible"
            ],
            "title": "Urgency",
            "default": "Normal"
          },
          "preferred_start": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Preferred Start"
          },
          "deadline": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
