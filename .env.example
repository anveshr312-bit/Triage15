# Set these in the process environment or root .env
DATABASE_URL=sqlite:///./triage15.db
OFFER_TTL_SECONDS=300
ML_ENABLED=true

# Supabase Authentication
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
